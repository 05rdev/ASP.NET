@{
    Layout = "_LayoutAdmin";
}
@model IEnumerable<CMS.Data.Entities.Category>

<div class="container-fluid py-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold text-dark">
                <i class="bi bi-tags-fill text-primary me-2"></i>DANH MỤC BÀI VIẾT
            </h4>
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 shadow-sm font-weight-bold">
                <i class="bi bi-plus-lg me-1"></i> Thêm danh mục mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>Tên Danh Mục</th>
                            <th>Mô Tả</th>
                            <th class="text-end pe-4" style="width: 200px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@item.Id</td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Name</span>
                                </td>
                                <td>
                                    <span class="text-secondary">@(string.IsNullOrEmpty(item.Description) ? "Không có mô tả" : item.Description)</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary px-3 rounded-start-3">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger px-3 rounded-end-3"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Pagination" />
    </div>
</div>
