@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Cập nhật sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-3">
        <div class="card-header bg-primary text-white py-3 rounded-top-3">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CẬP NHẬT SẢN PHẨM</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <!-- Khóa chính của sản phẩm -->
                <input type="hidden" asp-for="Id" />
                <!-- Giữ lại URL ảnh cũ nếu không chọn ảnh mới -->
                <input type="hidden" asp-for="ImageUrl" />

                <div class="row">
                    <!-- Left column: Primary information -->
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Tên sản phẩm:</label>
                            <input asp-for="Name" class="form-control form-control-lg border-2 rounded-2" placeholder="Nhập tên sản phẩm..." required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Mô tả chi tiết:</label>
                            <textarea asp-for="Description" class="form-control border-2 rounded-2" rows="6" placeholder="Nhập mô tả chi tiết sản phẩm..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Right column: Parameters and Actions -->
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Danh mục sản phẩm:</label>
                            <select asp-for="CategoryProductId" class="form-select border-2 rounded-2" asp-items="ViewBag.CategoryProductId" required>
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryProductId" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold text-secondary">Giá bán (VNĐ):</label>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control border-2 rounded-2" placeholder="0.00" required />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold text-secondary">Số lượng kho:</label>
                                <input asp-for="StockQuantity" type="number" min="0" class="form-control border-2 rounded-2" placeholder="0" required />
                                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Hình ảnh sản phẩm:</label>
                            <input type="file" name="uploadImage" id="uploadImage" class="form-control border-2 rounded-2" accept="image/*" />
                            
                            <!-- Hiển thị ảnh hiện tại -->
                            <div class="mt-2 text-center border rounded-2 p-2 bg-light" id="imagePreviewContainer">
                                <span class="d-block text-muted small mb-1" id="previewLabel">Ảnh hiện tại:</span>
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img id="imagePreview" src="@Model.ImageUrl" class="img-fluid rounded-2 shadow-sm" style="max-height: 150px; object-fit: contain;" />
                                }
                                else
                                {
                                    <img id="imagePreview" src="/images/no-image.png" class="img-fluid rounded-2 shadow-sm" style="max-height: 150px; object-fit: contain;" />
                                }
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                <i class="bi bi-cloud-arrow-up-fill"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg shadow-sm">
                                <i class="bi bi-arrow-left-short"></i> Hủy & Quay lại
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview selected image before uploading
        document.getElementById('uploadImage').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('imagePreview');
                    preview.src = e.target.result;
                    document.getElementById('previewLabel').textContent = "Ảnh mới chọn:";
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
