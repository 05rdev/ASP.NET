@model IEnumerable<CMS.Data.Entities.Product>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">QUẢN LÝ SẢN PHẨM</h2>
        <button class="btn btn-success btn-sm">+ Thêm sản phẩm mới</button>
    </div>

    <table class="table table-hover shadow-sm border align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 5%;">ID</th>
                <th style="width: 10%;">Hình Ảnh</th>
                <th style="width: 25%;">Tên Sản Phẩm</th>
                <th style="width: 15%;">Danh Mục</th>
                <th style="width: 15%;">Giá Bán</th>
                <th style="width: 15%;" class="text-center">Kho Hàng</th>
                <th style="width: 15%;" class="text-center">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" class="img-thumbnail" style="max-width: 60px; max-height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted" style="font-size: 12px;">Không có ảnh</span>
                            }
                        </td>
                        <td>
                            <strong>@product.Name</strong>
                            @if (!string.IsNullOrEmpty(product.Description))
                            {
                                <small class="text-muted d-block text-truncate" style="max-width: 250px;" title="@product.Description">
                                    @product.Description
                                </small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @(product.CategoryProduct?.Name ?? "Chưa phân loại")
                            </span>
                        </td>
                        <td class="text-danger fw-bold">
                            @product.Price.ToString("#,##0") đ
                        </td>
                        <td class="text-center">
                            @if (product.StockQuantity <= 0)
                            {
                                <span class="badge bg-danger">Hết hàng</span>
                            }
                            else if (product.StockQuantity <= 5)
                            {
                                <span class="badge bg-warning text-dark">Sắp hết (@product.StockQuantity)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@product.StockQuantity</span>
                            }
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-warning">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-3">Không có sản phẩm nào được tìm thấy.</td>
                </tr>
            }
        </tbody>
    </table>
</div>