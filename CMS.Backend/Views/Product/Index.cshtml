@model IEnumerable<CMS.Data.Entities.Product>
@{
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold text-dark">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>QUẢN LÝ SẢN PHẨM
            </h4>
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 shadow-sm font-weight-bold">
                <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th style="width: 100px;">Hình Ảnh</th>
                            <th>Tên Sản Phẩm</th>
                            <th>Danh Mục</th>
                            <th>Giá Bán</th>
                            <th class="text-center" style="width: 150px;">Kho Hàng</th>
                            <th class="text-end pe-4" style="width: 200px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var product in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@product.Id</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <div class="border rounded" style="width: 50px; height: 50px; overflow: hidden;">
                                                <img src="@product.ImageUrl" alt="@product.Name" class="w-100 h-100" style="object-fit: cover;" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border px-2 py-1 rounded">Không ảnh</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@product.Name</div>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <small class="text-muted d-block text-truncate" style="max-width: 250px;" title="@product.Description">
                                                @product.Description
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(product.CategoryProduct?.Name ?? "Chưa phân loại")
                                        </span>
                                    </td>
                                    <td class="text-danger fw-bold">
                                        @product.Price.ToString("#,##0") đ
                                    </td>
                                    <td class="text-center">
                                        @if (product.StockQuantity <= 0)
                                        {
                                            <span class="badge badge-custom-danger px-2.5 py-1 rounded-2">Hết hàng</span>
                                        }
                                        else if (product.StockQuantity <= 5)
                                        {
                                            <span class="badge badge-custom-warning px-2.5 py-1 rounded-2">Sắp hết (@product.StockQuantity)</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-custom-success px-2.5 py-1 rounded-2">@product.StockQuantity SP</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary px-3 rounded-start-3">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger px-3 rounded-end-3" 
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                    Không có sản phẩm nào được tìm thấy.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>