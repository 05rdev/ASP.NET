@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
}
<div class="container-fluid py-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i>QUẢN LÝ THÀNH VIÊN
            </h4>
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 shadow-sm font-weight-bold">
                <i class="bi bi-plus-lg me-1"></i> Thêm thành viên mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>Tên Đăng Nhập</th>
                            <th>Họ Và Tên</th>
                            <th>Quyền Hạn</th>
                            <th class="text-end pe-4" style="width: 200px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@user.Id</td>
                                <td>
                                    <span class="fw-semibold text-dark">@user.Username</span>
                                </td>
                                <td>@user.FullName</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge badge-custom-admin px-2.5 py-1 rounded-2">@user.Role</span>
                                    }
                                    else if (user.Role == "Editor")
                                    {
                                        <span class="badge badge-custom-editor px-2.5 py-1 rounded-2">@user.Role</span>
                                    }
                                    else if (user.Role == "Moderator")
                                    {
                                        <span class="badge badge-custom-moderator px-2.5 py-1 rounded-2">@user.Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-custom-user px-2.5 py-1 rounded-2">@user.Role</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary px-3 rounded-start-3">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger px-3 rounded-end-3" 
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên này không?');">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
