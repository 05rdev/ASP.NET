@model IEnumerable<CMS.Data.Entities.Post>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Bài viết";

    // Helper to strip HTML tags for clean card excerpt
    string StripHtml(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        // Strip HTML tags using Regex
        string clean = System.Text.RegularExpressions.Regex.Replace(input, "<.*?>", string.Empty);
        // Replace common HTML entity codes
        clean = clean.Replace("&nbsp;", " ").Replace("&amp;", "&").Replace("&lt;", "<").Replace("&gt;", ">");
        return clean;
    }
}

<div class="container mt-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-dark fw-bold mb-0">DANH SÁCH BÀI VIẾT</h2>
            <p class="text-muted small mb-0">Quản lý tin tức, sự kiện và các bài viết cẩm nang trên website</p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-sm shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Viết bài mới
        </a>
    </div>

    <!-- Posts Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
                    <div class="card w-100 shadow-sm border-0 rounded-3 overflow-hidden transition-hover d-flex flex-column" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                        
                        <!-- Card Image -->
                        <div class="position-relative overflow-hidden" style="height: 200px; background-color: #f1f5f9;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="w-100 h-100" alt="@item.Title" style="object-fit: cover; transition: transform 0.3s ease;" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                                    <i class="bi bi-image-fill display-6 mb-2"></i>
                                    <span style="font-size: 13px;">Không có hình ảnh</span>
                                </div>
                            }
                            
                            <!-- Category Badge -->
                            <span class="position-absolute top-0 start-0 m-3 badge bg-primary shadow-sm py-2 px-3 rounded-pill" style="font-weight: 600; font-size: 0.75rem;">
                                @(item.Category?.Name ?? "Chưa phân loại")
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4 d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <!-- Date & Meta -->
                                <div class="text-muted small mb-2 d-flex align-items-center gap-1">
                                    <i class="bi bi-calendar3"></i>
                                    <span>@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                                </div>

                                <!-- Title -->
                                <h5 class="card-title fw-bold text-dark mb-2 text-line-clamp-2" style="font-size: 1.1rem; line-height: 1.4; height: 3.08rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Title">
                                    @item.Title
                                </h5>

                                <!-- Excerpt (Clean text) -->
                                <p class="card-text text-muted small mb-4" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; height: 3.6rem; line-height: 1.6;">
                                    @(string.IsNullOrEmpty(item.Content) ? "Không có nội dung mô tả." : StripHtml(item.Content))
                                </p>
                            </div>

                            <!-- Actions Row -->
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto gap-2">
                                <a href="/Post/Details/@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 flex-grow-1">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 flex-grow-1">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-2"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')" title="Xóa bài viết">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted mb-3">
                    <i class="bi bi-file-earmark-x display-1"></i>
                </div>
                <h4 class="text-secondary fw-semibold">Không tìm thấy bài viết nào</h4>
                <p class="text-muted">Bắt đầu bằng việc viết và đăng bài viết đầu tiên của bạn.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill mt-2">
                    <i class="bi bi-plus-circle"></i> Viết bài mới ngay
                </a>
            </div>
        }
    </div>
</div>

<style>
    /* Card Hover Zoom Effect */
    .transition-hover:hover {
        transform: translateY(-6px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1) !important;
    }
    .transition-hover:hover img {
        transform: scale(1.05);
    }
</style>
