@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa bài viết";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-3">
        <div class="card-header bg-primary text-white py-3 rounded-top-3">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> SỬA BÀI VIẾT</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <!-- Left column -->
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Tiêu đề bài viết:</label>
                            <input asp-for="Title" class="form-control form-control-lg border-2 rounded-2" placeholder="Nhập tiêu đề..." required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Nội dung chi tiết:</label>
                            <textarea asp-for="Content" class="form-control border-2 rounded-2" rows="10" placeholder="Viết nội dung tại đây..."></textarea>
                        </div>
                    </div>

                    <!-- Right column -->
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Chuyên mục:</label>
                            <select asp-for="CategoryId" class="form-select border-2 rounded-2" asp-items="ViewBag.CategoryList" required>
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Hình ảnh đại diện:</label>
                            <div class="mb-2">
                                <label class="form-label small text-muted">Tải ảnh mới từ thiết bị:</label>
                                <input type="file" name="uploadImage" id="uploadImage" class="form-control border-2 rounded-2" accept="image/*" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-muted">Hoặc link ảnh hiện tại / mới (URL):</label>
                                <input asp-for="ImageUrl" id="ImageUrl" class="form-control border-2 rounded-2" placeholder="https://..." />
                            </div>

                            <!-- Preview Image Section -->
                            <div class="mt-2 text-center border rounded-2 p-2 bg-light" id="imagePreviewContainer">
                                <span class="d-block text-muted small mb-1" id="previewLabel">Ảnh hiện tại:</span>
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img id="imagePreview" src="@Model.ImageUrl" class="img-fluid rounded-2 shadow-sm" style="max-height: 150px; object-fit: contain;" />
                                }
                                else
                                {
                                    <img id="imagePreview" src="/images/no-image.png" class="img-fluid rounded-2 shadow-sm" style="max-height: 150px; object-fit: contain;" />
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Ngày đăng:</label>
                            <input asp-for="CreatedDate" type="date" class="form-control border-2 rounded-2" value="@Model.CreatedDate.ToString("yyyy-MM-dd")" />
                        </div>

                        <hr class="my-4" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                <i class="bi bi-cloud-arrow-up-fill"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg shadow-sm">
                                <i class="bi bi-arrow-left-short"></i> Hủy & Quay lại
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        // 1. Kích hoạt trình soạn thảo cho thẻ textarea có id là 'Content'
        ClassicEditor
            .create(document.querySelector('#Content'))
            .catch(error => {
                console.error(error);
            });

        // 2. Xử lý Preview ảnh
        const uploadImage = document.getElementById('uploadImage');
        const imageUrlInput = document.getElementById('ImageUrl');
        const previewContainer = document.getElementById('imagePreviewContainer');
        const imagePreview = document.getElementById('imagePreview');
        const previewLabel = document.getElementById('previewLabel');

        function showPreview(src, labelText) {
            imagePreview.src = src;
            previewLabel.textContent = labelText;
            previewContainer.classList.remove('d-none');
        }

        // Preview từ file tải lên
        uploadImage.addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                // Xóa giá trị input Link ảnh để tránh nhập nhằng
                imageUrlInput.value = "";
                
                const reader = new FileReader();
                reader.onload = function (e) {
                    showPreview(e.target.result, "Ảnh mới chọn từ máy:");
                };
                reader.readAsDataURL(file);
            }
        });

        // Preview từ Link URL nhập vào
        imageUrlInput.addEventListener('input', function () {
            const url = this.value.trim();
            if (url) {
                // Xóa file đã chọn để tránh nhập nhằng
                uploadImage.value = "";
                showPreview(url, "Ảnh từ link mới (URL):");
            } else {
                // Nếu xóa trắng link và không chọn file, có thể ẩn preview hoặc quay về trạng thái ban đầu
                imagePreview.src = "/images/no-image.png";
                previewLabel.textContent = "Không có ảnh:";
            }
        });
    </script>
}
