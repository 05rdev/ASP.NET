Version: 1.2 *@

@model CMS.Data.Entities.Customer
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa thông tin khách hàng";
}

<div class="container py-4" style="max-width: 800px;">
    <!-- Back button -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách khách hàng
        </a>
    </div>

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h3 mb-1 text-gray-800 fw-bold text-primary">
            <i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA THÔNG TIN KHÁCH HÀNG
        </h1>
        <p class="text-muted small">Cập nhật thông tin tài khoản cho khách hàng <strong>@Model.FullName</strong> (ID: #@Model.Id).</p>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                <!-- Hidden key -->
                <input type="hidden" asp-for="Id" />

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span>Vui lòng kiểm tra lại thông tin nhập vào!</span>
                        <div asp-validation-summary="All" class="small mt-2 text-danger"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Họ và Tên -->
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold text-dark">Họ và Tên <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên khách hàng..." required />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-dark">Địa chỉ Email <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email liên hệ..." required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Số Điện Thoại -->
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold text-dark">Số Điện Thoại</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                        <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại liên hệ..." />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Địa Chi -->
                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold text-dark">Địa Chỉ Giao Hàng</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-geo-alt"></i></span>
                        <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ của khách hàng..." />
                    </div>
                    <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Mật Khẩu -->
                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold text-dark">Mật Khẩu Đăng Nhập <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <hr class="my-4 text-secondary opacity-25" />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-2 fw-semibold">
                        <i class="bi bi-save-fill me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
