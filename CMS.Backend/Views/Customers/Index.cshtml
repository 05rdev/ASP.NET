@model IEnumerable<CMS.Data.Entities.Customer>
@{
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i>QUẢN LÝ KHÁCH HÀNG
            </h4>
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 shadow-sm font-weight-bold">
                <i class="bi bi-plus-lg me-1"></i> Thêm khách hàng mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>Họ và Tên</th>
                            <th>Email</th>
                            <th>Số Điện Thoại</th>
                            <th>Địa Chỉ</th>
                            <th class="text-center" style="width: 120px;">Đơn Mua</th>
                            <th class="text-end pe-4" style="width: 200px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var customer in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@customer.Id</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@customer.FullName</div>
                                    </td>
                                    <td>
                                        <a href="mailto:@customer.Email" class="text-decoration-none text-dark fw-medium">
                                            @customer.Email
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">@(string.IsNullOrEmpty(customer.Phone) ? "---" : customer.Phone)</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(customer.Address))
                                        {
                                            <span class="d-inline-block text-truncate text-secondary small" style="max-width: 220px;" title="@customer.Address">
                                                @customer.Address
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">Chưa cập nhật</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-2 fw-semibold">
                                            @(customer.Orders?.Count ?? 0) đơn
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-outline-primary px-3 rounded-start-3">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-outline-danger px-3 rounded-end-3"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?')">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                    Không có khách hàng nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>