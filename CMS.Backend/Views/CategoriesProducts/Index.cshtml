@model IEnumerable<CMS.Data.Entities.CategoryProduct>
@{
    Layout = "_LayoutAdmin";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">QUẢN LÝ DANH MỤC SẢN PHẨM</h2>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle"></i> Thêm danh mục mới
        </a>
    </div>

    <table class="table table-hover shadow-sm border">
        <thead class="table-light">
            <tr>
                <th style="width: 10%;">ID</th>
                <th style="width: 30%;">Tên Danh Mục</th>
                <th style="width: 35%;">Mô Tả</th>
                <th style="width: 10%;" class="text-center">Số Sản Phẩm</th>
                <th style="width: 15%;" class="text-center">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td><strong>@category.Name</strong></td>
                        <td>@(string.IsNullOrEmpty(category.Description) ? "Không có mô tả" : category.Description)</td>
                        <td class="text-center">
                            <span class="badge bg-secondary">
                                @(category.Products?.Count ?? 0)
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger" 
                               onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục sản phẩm này?')">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">Không có danh mục nào được tìm thấy.</td>
                </tr>
            }
        </tbody>
    </table>
</div>