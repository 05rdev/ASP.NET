@model IEnumerable<CMS.Data.Entities.Order>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">QUẢN LÝ ĐƠN HÀNG</h2>
        <button class="btn btn-success btn-sm">+ Tạo đơn hàng mới</button>
    </div>

    <table class="table table-hover shadow-sm border align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 8%;">Mã ĐH</th>
                <th style="width: 22%;">Khách Hàng</th>
                <th style="width: 20%;">Ngày Đặt</th>
                <th style="width: 20%;">Trạng Thái</th>
                <th style="width: 15%;">Ghi Chú</th>
                <th style="width: 15%;" class="text-center">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var order in Model)
                {
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>
                            <span class="fw-bold">@(order.Customer?.FullName ?? "Khách vãng lai")</span>
                        </td>
                        <td>
                            @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            @if (order.Status == 0)
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Chờ duyệt</span>
                            }
                            else if (order.Status == 1)
                            {
                                <span class="badge bg-primary"><i class="bi bi-truck"></i> Đang giao</span>
                            }
                            else if (order.Status == 2)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Đã xong</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Không xác định</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(order.Notes))
                            {
                                <small class="text-muted text-truncate d-block" style="max-width: 180px;" title="@order.Notes">
                                    @order.Notes
                                </small>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size: 12px;">---</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("Details", "Orders", new { id = order.Id })" class="btn btn-sm btn-outline-info" title="Xem chi tiết">Chi tiết</a>
                            <button class="btn btn-sm btn-outline-warning" title="Cập nhật trạng thái">Sửa</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">Không có đơn hàng nào trong hệ thống.</td>
                </tr>
            }
        </tbody>
    </table>
</div>