@model CMS.Data.Entities.Order

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">CHI TIẾT ĐƠN HÀNG #@Model.Id</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <strong class="text-secondary">Thông tin khách hàng & Đơn hàng</strong>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Khách hàng:</strong> @(Model.Customer?.FullName ?? "Khách vãng lai")</p>
                    <p><strong>Số điện thoại:</strong> @(Model.Customer?.Phone ?? "---")</p>
                    <p><strong>Địa chỉ nhận hàng:</strong> @(Model.Customer?.Address ?? "---")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p>
                        <strong>Trạng thái:</strong>
                        @if (Model.Status == 0)
                        {
                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                        }
                        else if (Model.Status == 1)
                        {
                            <span class="badge bg-primary">Đang giao</span>
                        }
                        else if (Model.Status == 2)
                        {
                            <span class="badge bg-success">Đã xong</span>
                        }
                    </p>
                    <p><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "Không có ghi chú" : Model.Notes)</p>
                </div>
            </div>
        </div>
    </div>

    <h4 class="text-dark mb-3">Danh sách sản phẩm đã đặt</h4>
    <table class="table table-bordered table-hover shadow-sm text-center align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 10%;">STT</th>
                <th style="width: 40%;" class="text-start">Tên Sản Phẩm</th>
                <th style="width: 15%;">Giá Mua</th>
                <th style="width: 15%;">Số Lượng</th>
                <th style="width: 20%;">Thành Tiền</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.OrderDetails != null && Model.OrderDetails.Any())
            {
                int stt = 1;
                decimal tongTienDonHang = 0;

                foreach (var detail in Model.OrderDetails)
                {
                    decimal thanhTien = detail.Quantity * detail.UnitPrice;
                    tongTienDonHang += thanhTien;

                    <tr>
                        <td>@stt</td>
                        <td class="text-start">
                            <strong>@(detail.Product?.Name ?? "Sản phẩm không tồn tại hoặc đã xóa")</strong>
                        </td>
                        <td class="text-danger">@detail.UnitPrice.ToString("#,##0") đ</td>
                        <td>@detail.Quantity</td>
                        <td class="fw-bold text-danger">@thanhTien.ToString("#,##0") đ</td>
                    </tr>
                    stt++;
                }

                <tr class="table-light">
                    <td colspan="4" class="text-end fw-bold">Tổng số tiền thanh toán:</td>
                    <td class="fw-bold text-danger fs-5">@tongTienDonHang.ToString("#,##0") đ</td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">Đơn hàng này chưa có sản phẩm nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>