@model CMS.Data.Entities.CategoryProduct
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="container py-4" style="max-width: 800px;">
    <!-- Breadcrumb or Back button -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách danh mục
        </a>
    </div>

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h3 mb-1 text-gray-800 fw-bold text-primary">
            <i class="bi bi-plus-circle-fill me-2"></i>THÊM DANH MỤC SẢN PHẨM MỚI
        </h1>
        <p class="text-muted small">Tạo danh mục mới để phân loại và sắp xếp sản phẩm thời trang trong cửa hàng.</p>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" class="needs-validation" novalidate>
                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span>Vui lòng kiểm tra lại thông tin nhập vào!</span>
                        <div asp-validation-summary="All" class="small mt-2 text-danger"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Tên danh mục -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-dark">Tên danh mục <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-tag"></i></span>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Giày cao gót, Đầm dạ hội..." required />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Mô tả -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold text-dark">Mô tả danh mục</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập một vài thông tin mô tả chi tiết về danh mục này..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row">
                    <!-- Thứ tự hiển thị -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold text-dark">Thứ tự hiển thị</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-sort-numeric-down"></i></span>
                            <input asp-for="DisplayOrder" type="number" class="form-control" min="0" placeholder="0" />
                        </div>
                        <p class="text-muted small mt-1 mb-0" style="font-size: 0.8rem;">Thứ tự nhỏ hơn sẽ được ưu tiên hiển thị trước.</p>
                        <span asp-validation-for="DisplayOrder" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Trạng thái hoạt động -->
                    <div class="col-md-6 mb-3 d-flex align-items-center">
                        <div class="form-check form-switch ps-4 pt-3">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked id="isActiveSwitch" />
                            <label class="form-check-label fw-semibold text-dark ms-2" for="isActiveSwitch">Kích hoạt danh mục này</label>
                            <p class="text-muted small mb-0 mt-1" style="font-size: 0.8rem;">Nếu tắt, danh mục này sẽ ẩn ngoài trang bán hàng.</p>
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-secondary opacity-25" />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-2">
                        <i class="bi bi-save me-1"></i> Lưu vào hệ thống
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
