@model IEnumerable<CMS.Data.Entities.CategoryProduct>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Danh mục Sản phẩm";
}

<div class="container-fluid py-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold text-dark">
                <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>DANH MỤC SẢN PHẨM
            </h4>
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 shadow-sm font-weight-bold">
                <i class="bi bi-plus-lg me-1"></i> Thêm danh mục mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>Tên Danh Mục</th>
                            <th>Mô Tả</th>
                            <th class="text-center" style="width: 100px;">Thứ tự</th>
                            <th class="text-center" style="width: 150px;">Trạng thái</th>
                            <th class="text-center" style="width: 120px;">Số sản phẩm</th>
                            <th class="text-end pe-4" style="width: 200px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var category in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@category.Id</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@category.Name</div>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">
                                            @(string.IsNullOrEmpty(category.Description) ? "Không có mô tả" : category.Description)
                                        </span>
                                    </td>
                                    <td class="text-center fw-semibold text-dark">
                                        @category.DisplayOrder
                                    </td>
                                    <td class="text-center">
                                        @if (category.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-2">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-2">Tạm khóa</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-2 fw-semibold">
                                            @(category.Products?.Count ?? 0) SP
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-outline-primary px-3 rounded-start-3">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-outline-danger px-3 rounded-end-3"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục &ldquo;@category.Name&rdquo; không?')">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                    Không tìm thấy danh mục sản phẩm nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Pagination" />
    </div>
</div>

<style>
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1) !important; }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1) !important; }
    .bg-secondary-subtle { background-color: rgba(108, 117, 125, 0.1) !important; }
    .bg-light-primary { background-color: rgba(13, 110, 253, 0.1) !important; }
</style>