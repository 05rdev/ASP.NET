MSSV: 2123110052
Version: 1.2 *@

@model IEnumerable<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container-fluid py-4">
    <!-- Header Page -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i>QUẢN LÝ ĐƠN HÀNG
            </h1>
            <p class="text-muted small mb-0">Xem danh sách, kiểm tra chi tiết, cập nhật trạng thái hoặc hủy/xóa đơn hàng mua sắm.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Tạo đơn hàng mới</span>
        </a>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light py-3 border-bottom">
                        <tr>
                            <th class="px-4 py-3 text-uppercase font-weight-bold text-muted small" style="width: 10%;">Mã ĐH</th>
                            <th class="py-3 text-uppercase font-weight-bold text-muted small" style="width: 25%;">Khách Hàng</th>
                            <th class="py-3 text-uppercase font-weight-bold text-muted small" style="width: 20%;">Ngày Đặt</th>
                            <th class="py-3 text-center text-uppercase font-weight-bold text-muted small" style="width: 15%;">Trạng Thái</th>
                            <th class="py-3 text-uppercase font-weight-bold text-muted small" style="width: 15%;">Ghi Chú</th>
                            <th class="px-4 py-3 text-end text-uppercase font-weight-bold text-muted small" style="width: 15%;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var order in Model)
                            {
                                <tr>
                                    <td class="px-4 text-muted fw-bold">#@order.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-icon bg-light-info text-info rounded-circle p-2 me-2 d-none d-sm-flex justify-content-center align-items-center" style="width: 36px; height: 36px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-semibold text-dark">@(order.Customer?.FullName ?? "Khách vãng lai")</h6>
                                                @if (order.Customer != null)
                                                {
                                                    <span class="text-muted small" style="font-size: 0.75rem;">@order.Customer.Phone</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-secondary small">
                                            <i class="bi bi-calendar-event me-1"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (order.Status == 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-clock-history me-1"></i> Chờ duyệt
                                            </span>
                                        }
                                        else if (order.Status == 1)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-truck me-1"></i> Đang giao
                                            </span>
                                        }
                                        else if (order.Status == 2)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> Đã xong
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-question-circle me-1"></i> Không rõ
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.Notes))
                                        {
                                            <span class="text-muted small text-truncate d-block" style="max-width: 180px;" title="@order.Notes">
                                                @order.Notes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">---</span>
                                        }
                                    </td>
                                    <td class="px-4 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1 px-2.5 rounded-2">
                                                <i class="bi bi-info-circle-fill"></i> Chi tiết
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1 px-2.5 rounded-2">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-2.5 rounded-2"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng #@order.Id không? Thao tác này không thể hoàn tác.')">
                                                <i class="bi bi-trash3-fill"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-receipt display-4 text-secondary mb-3 d-block"></i>
                                    <span>Chưa có đơn hàng nào được tạo trong hệ thống.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1) !important; }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1) !important; }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.1) !important; }
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1) !important; }
    .bg-secondary-subtle { background-color: rgba(108, 117, 125, 0.1) !important; }
    .bg-light-info { background-color: rgba(13, 202, 240, 0.1) !important; }
</style>