Version: 1.2 *@

@model IEnumerable<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container-fluid py-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold text-dark">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i>QUẢN LÝ ĐƠN HÀNG
            </h4>
            <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 shadow-sm font-weight-bold">
                <i class="bi bi-plus-lg me-1"></i> Tạo đơn hàng mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4" style="width: 100px;">Mã ĐH</th>
                            <th>Khách Hàng</th>
                            <th>Ngày Đặt</th>
                            <th class="text-center" style="width: 150px;">Trạng Thái</th>
                            <th>Ghi Chú</th>
                            <th class="text-end pe-4" style="width: 250px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var order in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@order.Id</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(order.Customer?.FullName ?? "Khách vãng lai")</div>
                                        @if (order.Customer != null)
                                        {
                                            <span class="text-muted small" style="font-size: 0.75rem;">@order.Customer.Phone</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-secondary small">
                                            <i class="bi bi-calendar-event me-1"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (order.Status == 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1 rounded-2">Chờ duyệt</span>
                                        }
                                        else if (order.Status == 1)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-2">Đang giao</span>
                                        }
                                        else if (order.Status == 2)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-2">Đã xong</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-2">Không rõ</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.Notes))
                                        {
                                            <span class="text-muted small text-truncate d-block" style="max-width: 180px;" title="@order.Notes">
                                                @order.Notes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">---</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-info px-3 rounded-start-3">
                                                <i class="bi bi-info-circle"></i> Chi tiết
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-outline-primary px-3">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-outline-danger px-3 rounded-end-3"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng #@order.Id không?')">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                    Chưa có đơn hàng nào được tạo trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1) !important; }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1) !important; }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.1) !important; }
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1) !important; }
    .bg-secondary-subtle { background-color: rgba(108, 117, 125, 0.1) !important; }
    .bg-light-info { background-color: rgba(13, 202, 240, 0.1) !important; }
</style>