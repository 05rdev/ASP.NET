@model CMS.Data.Entities.Order
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Cập nhật đơn hàng";
}

<div class="container py-4" style="max-width: 800px;">
    <!-- Back button -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn hàng
        </a>
    </div>

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h3 mb-1 text-gray-800 fw-bold text-warning">
            <i class="bi bi-pencil-square me-2"></i>CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG
        </h1>
        <p class="text-muted small">Cập nhật tiến trình giao hàng hoặc sửa đổi thông tin ghi chú cho đơn hàng mã số <strong>#@Model.Id</strong>.</p>
    </div>

    <!-- Info Box -->
    <div class="card bg-light border-0 mb-4 rounded-3">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <div class="col-md-6 mb-2 mb-md-0">
                    <span class="text-muted small">Khách hàng:</span>
                    <strong class="text-dark d-block">@(Model.Customer?.FullName ?? "Khách vãng lai")</strong>
                </div>
                <div class="col-md-6">
                    <span class="text-muted small">Ngày đặt:</span>
                    <strong class="text-dark d-block">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                <!-- Hidden fields -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CustomerId" />
                <input type="hidden" asp-for="OrderDate" />

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span>Vui lòng kiểm tra lại thông tin nhập vào!</span>
                        <div asp-validation-summary="All" class="small mt-2 text-danger"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Cập nhật Trạng thái -->
                <div class="mb-4">
                    <label asp-for="Status" class="form-label fw-semibold text-dark">Trạng thái đơn hàng</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-info-circle"></i></span>
                        <select asp-for="Status" class="form-select">
                            <option value="0">Chờ duyệt</option>
                            <option value="1">Đang giao</option>
                            <option value="2">Đã xong</option>
                        </select>
                    </div>
                    <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Ghi chú đơn hàng -->
                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-semibold text-dark">Ghi chú đơn hàng</label>
                    <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Nhập thêm ghi chú đơn hàng hoặc thông tin yêu cầu của khách..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small mt-1 d-block"></span>
                </div>

                <hr class="my-4 text-secondary opacity-25" />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning text-dark fw-semibold px-4 py-2 rounded-2">
                        <i class="bi bi-save-fill me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
