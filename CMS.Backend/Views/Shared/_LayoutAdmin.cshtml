<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VanDinhCMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }

        /* Sidebar Styling */
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            box-shadow: 4px 0 25px rgba(0, 0, 0, 0.15);
            transition: all 0.3s ease;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 1000;
            overflow-y: auto;
        }

        .sidebar::-webkit-scrollbar {
            width: 6px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 3px;
        }
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        .sidebar-brand {
            padding: 24px 20px;
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .sidebar-brand span {
            color: #3b82f6; /* Modern Blue accent */
        }

        .sidebar-menu {
            padding: 20px 14px;
        }

        .sidebar-menu-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            padding: 10px 16px 6px;
            font-weight: 700;
        }

        .sidebar a {
            color: #94a3b8;
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 12px 16px;
            margin-bottom: 4px;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.925rem;
            transition: all 0.2s ease-in-out;
        }

        .sidebar a i {
            font-size: 1.1rem;
            margin-right: 12px;
            transition: transform 0.2s ease;
        }

        .sidebar a:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: #ffffff;
        }

        .sidebar a:hover i {
            transform: translateX(3px);
        }

        .sidebar a.active {
            background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.35);
        }

        /* Main Content Layout Adjustments */
        .main-content {
            margin-left: 16.666667%; /* Compares to col-md-2 width */
            padding: 40px;
            min-height: 100vh;
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: relative;
                min-height: auto;
                width: 100%;
            }
            .main-content {
                margin-left: 0;
                padding: 20px;
            }
        }

        /* Card and general component enhancements for uniform premium styling */
        .card {
            border: none !important;
            border-radius: 12px !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
        }

        .table {
            border-radius: 8px;
            overflow: hidden;
        }

        /* Custom status/role badge styles to guarantee compatibility and contrast across Bootstrap versions */
        .badge-custom-admin {
            background-color: #f8d7da !important;
            color: #842029 !important;
            border: 1px solid #f5c2c7 !important;
        }
        .badge-custom-editor {
            background-color: #fff3cd !important;
            color: #664d03 !important;
            border: 1px solid #ffecb5 !important;
        }
        .badge-custom-moderator {
            background-color: #cfe2ff !important;
            color: #084298 !important;
            border: 1px solid #bacbe6 !important;
        }
        .badge-custom-user {
            background-color: #cff4fc !important;
            color: #087990 !important;
            border: 1px solid #b6effb !important;
        }
        .badge-custom-success {
            background-color: #d1e7dd !important;
            color: #0f5132 !important;
            border: 1px solid #badbcc !important;
        }
        .badge-custom-danger {
            background-color: #f8d7da !important;
            color: #842029 !important;
            border: 1px solid #f5c2c7 !important;
        }
        .badge-custom-warning {
            background-color: #fff3cd !important;
            color: #664d03 !important;
            border: 1px solid #ffecb5 !important;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar Navigation -->
            <nav class="col-md-3 col-lg-2 sidebar p-0">
                <div class="sidebar-brand text-center">
                    <i class="bi bi-cpu-fill text-primary me-2"></i>VanDinhCMS <span>Admin</span>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white">
                                    Chào, <strong>@User.FindFirst("FullName")?.Value</strong> (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                            </li>
                        }
                    </ul>

                </div>
                
                <div class="sidebar-menu">
                    <div class="sidebar-menu-label">Hệ Thống</div>
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Bảng điều khiển
                    </a>
                    <a asp-controller="User" asp-action="Index">
                        <i class="bi bi-shield-lock-fill"></i> Quản lý Thành viên
                    </a>

                    <div class="sidebar-menu-label mt-3">Nội Dung</div>
                    <a asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags-fill"></i> Danh mục bài viết
                    </a>
                    <a asp-controller="Post" asp-action="Index">
                        <i class="bi bi-file-earmark-post-fill"></i> Bài viết tin tức
                    </a>
                    <a asp-controller="Banner" asp-action="Index">
                        <i class="bi bi-images"></i> Quản lý Banner
                    </a>

                    <div class="sidebar-menu-label mt-3">Cửa Hàng</div>
                    <a asp-controller="CategoryProduct" asp-action="Index">
                        <i class="bi bi-grid-3x3-gap-fill"></i> Danh mục sản phẩm
                    </a>
                    <a asp-controller="Product" asp-action="Index">
                        <i class="bi bi-box-seam-fill"></i> Quản lý Sản phẩm
                    </a>
                    <a asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Khách hàng mua sắm
                    </a>
                    <a asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt-cutoff"></i> Quản lý Đơn hàng
                    </a>
                </div>
            </nav>

            <!-- Main Content Container -->
            <main class="col-md-9 col-lg-10 main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Automatic Sidebar Active State Script
        document.addEventListener("DOMContentLoaded", function() {
            const currentPath = window.location.pathname.toLowerCase();
            const sidebarLinks = document.querySelectorAll(".sidebar a");
            
            sidebarLinks.forEach(link => {
                const href = link.getAttribute("href");
                if (href) {
                    const lowerHref = href.toLowerCase();
                    // Split paths to check controller equality
                    const pathSegments = currentPath.split('/').filter(x => x);
                    const hrefSegments = lowerHref.split('/').filter(x => x);
                    
                    if (pathSegments.length > 0 && hrefSegments.length > 0) {
                        // Check if controller matches (usually first segment)
                        if (pathSegments[0] === hrefSegments[0]) {
                            link.classList.add("active");
                        }
                    } else if (lowerHref === "/" && currentPath === "/") {
                        link.classList.add("active");
                    }
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
